# Copy to .env / .env.local and fill in. Never commit real values.

# Public origin — REQUIRED in production (canonicals, hreflang, sitemap, robots)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Postgres (Neon). Pooled URL for the app, direct URL for migrations. Tables live in schema "livo".
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# Clerk (Core 2 — @clerk/nextjs@6 + @clerk/elements). Use pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth-callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth-callback

# Admin dashboard: these Clerk-verified emails become ADMIN on sign-in (comma-separated)
ADMIN_EMAIL=

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: a PUBLIC host for images (r2.dev or custom domain). The S3 API endpoint is ignored.
NEXT_PUBLIC_R2_PUBLIC_URL=
# Optional: 0 = serve /img from public/img instead of R2
ASSETS_FROM_R2=

# Stripe (not used yet)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_GA_ID=
